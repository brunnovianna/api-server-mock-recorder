{
  "name": "api-server-mock-recorder",
  "version": "0.1.0",
  "description": "Capture real HTTP traffic during development and save requests/responses as local JSON files.",
  "license": "MIT",
  "author": "Brunno Vianna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brunnovianna/api-server-mock-recorder.git"
  },
  "bugs": {
    "url": "https://github.com/brunnovianna/api-server-mock-recorder/issues"
  },
  "homepage": "https://github.com/brunnovianna/api-server-mock-recorder#readme",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "api-server-mock-recorder": "bin/api-server-mock-recorder"
  },
  "files": [
    "bin",
    "dist"
  ],
  "keywords": [
    "mock",
    "proxy",
    "api",
    "recorder",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.30",
    "typescript": "^5.9.3"
  }
}
